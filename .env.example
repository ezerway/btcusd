# ════════════════════════════════════════════════════════════════
# CHAINLINK DATA STREAMS & POLYMARKET SDK CREDENTIALS
# ════════════════════════════════════════════════════════════════

# Chainlink Data Streams Credentials (app.chain.link/streams)
CHAINLINK_API_KEY=your_chainlink_api_key_here
CHAINLINK_USER_SECRET=your_chainlink_hmac_secret_here

# Polymarket CLOB SDK Credentials (@polymarket/clob-client)
# Option A: L2 API Key Credentials
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=

# Option B: L1 Wallet Private Key (0x...) — SDK can auto-derive API Key/Secret/Passphrase
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=

# Application Configuration
PORT=3002
NODE_ENV=development
