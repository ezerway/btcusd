{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "/",
  "name": "BTC 5m Up/Down Terminal",
  "short_name": "BTC 5M",
  "description": "Real-time Bitcoin 5-minute Up/Down Price Monitor, Arbitrage Signal & Trading Terminal",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "window-controls-overlay"],
  "background_color": "#0b0f17",
  "theme_color": "#0b0f17",
  "orientation": "any",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "categories": ["finance", "utilities"],
  "shortcuts": [
    {
      "name": "Live Terminal",
      "url": "/",
      "description": "Open live BTC 5m signal monitor"
    }
  ]
}
